{
  "uid": "nginxvts-demo",
  "title": "Nginx VTS Dashboard",
  "tags": ["nginx", "vts", "demo"],
  "timezone": "",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "5s",
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "panels": [
    {
      "type": "row",
      "title": "Server Status",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Current Active Connections",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "nginx_vts_main_connections{status=\"active\", job=\"nginx\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          },
          "mappings": [],
          "displayName": "Active Connections"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "text": {
          "titleSize": 16,
          "valueSize": 40
        }
      }
    },
    {
      "type": "gauge",
      "title": "Total RPS",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "sum(rate(nginx_vts_main_connections{status=\"requests\", job=\"nginx\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "max": 1000,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          },
          "displayName": "Requests Per Second"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "horizontal"
      }
    },
    {
      "type": "stat",
      "title": "Response Codes",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 4 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "sum(rate(nginx_vts_server_requests_total{code=\"2xx\", job=\"nginx\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "2xx"
        },
        {
          "expr": "sum(rate(nginx_vts_server_requests_total{code=\"4xx\", job=\"nginx\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "4xx"
        },
        {
          "expr": "sum(rate(nginx_vts_server_requests_total{code=\"5xx\", job=\"nginx\"}[$__rate_interval]))",
          "refId": "C",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#299c46",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "Success (2xx)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#e0752d",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "Client Errors (4xx)"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 0.1 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#bf1b00",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "Server Errors (5xx)"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 0.01 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": false
      }
    },
    {
      "type": "row",
      "title": "Connection & Traffic Metrics",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Nginx Connections",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "nginx_vts_main_connections{status=\"active\", job=\"nginx\"}",
          "legendFormat": "active",
          "interval": "",
          "refId": "A"
        },
        {
          "expr": "nginx_vts_main_connections{status=\"accepted\", job=\"nginx\"}",
          "legendFormat": "accepted",
          "interval": "",
          "refId": "B"
        },
        {
          "expr": "nginx_vts_main_connections{status=\"handled\", job=\"nginx\"}",
          "legendFormat": "handled",
          "interval": "",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "spanNulls": false,
            "showPoints": "auto",
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "active" },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#73BF69",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "accepted" },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#5794F2",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "handled" },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#FADE2A",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per Second (RPS)",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "rate(nginx_vts_main_connections{status=\"requests\", job=\"nginx\"}[$__rate_interval])",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "#7EB26D"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "spanNulls": false,
            "showPoints": "auto",
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max", "mean"]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP Response Codes",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "sum by(code) (rate(nginx_vts_server_requests_total{job=\"nginx\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "spanNulls": false,
            "showPoints": "auto",
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "2xx" },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#299c46",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "4xx" },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#e0752d",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "5xx" },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#bf1b00",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Traffic (Bytes In/Out)",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "sum by(direction) (rate(nginx_vts_server_bytes_total{job=\"nginx\"}[$__rate_interval]))",
          "legendFormat": "Traffic {{direction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "spanNulls": false,
            "showPoints": "auto",
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "row",
      "title": "Performance Metrics",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Average Response Time",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 8 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "sum(rate(nginx_vts_server_request_seconds_total{job=\"nginx\"}[$__rate_interval])) / sum(rate(nginx_vts_server_requests_total{job=\"nginx\"}[$__rate_interval]))",
          "legendFormat": "Avg Response Time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "spanNulls": false,
            "showPoints": "auto",
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max", "mean"]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ]
}