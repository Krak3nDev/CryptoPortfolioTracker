{
  "uid": "cryptoapp-business",
  "title": "CryptoApp Business Metrics",
  "tags": ["business", "crypto", "users", "emails"],
  "timezone": "",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(host)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "panels": [
    {
      "type": "row",
      "title": "Business KPIs",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Emails Sent (24h)",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "sum(increase(send_mail_count{host=~\"$host\"}[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 5000 }
            ]
          },
          "mappings": [],
          "displayName": "Emails Sent"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "text": {
          "titleSize": 16,
          "valueSize": 40
        }
      }
    },
    {
      "type": "row",
      "title": "Email Metrics",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Email Sending Rate",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "sum(rate(send_mail_count{host=~\"$host\"}[$__rate_interval])) * 3600",
          "legendFormat": "Emails Per Hour",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 5,
            "spanNulls": false,
            "showPoints": "auto",
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max", "mean"]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ]
}