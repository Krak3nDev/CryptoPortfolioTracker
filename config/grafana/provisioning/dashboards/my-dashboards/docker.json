{
  "title": "Docker Container Monitoring Dashboard",
  "uid": "docker-containers-monitoring",
  "schemaVersion": 36,
  "version": 1,
  "tags": ["docker", "containers", "cadvisor", "monitoring", "performance"],
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
  },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "query": "label_values(container_cpu_usage_seconds_total, name)",
        "regex": "",
        "sort": 1,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "interval",
        "label": "Interval",
        "type": "interval",
        "query": "1m,5m,10m,30m,1h,6h,12h,1d",
        "current": {
          "selected": true,
          "text": "5m",
          "value": "5m"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Total Running Containers",
      "id": 1,
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "count(\n  container_last_seen{\n    id=~\"^/system\\\\.slice/docker-.*$\", \n    name=~\"$container\", \n    name!=\"\"\n  }\n)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Total CPU Usage",
      "id": 2,
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "sum(\n  max by (name)(\n    rate(\n      container_cpu_usage_seconds_total{\n        id=~\"^/system\\\\.slice/docker-.*$\",\n        name=~\"$container\"\n      }[$interval]\n    )\n  )\n) * 100",          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Memory Usage",
      "id": 3,
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "sum(\n  max by (name)(\n    container_memory_usage_bytes{\n      id=~\"^/system\\\\.slice/docker-.*$\",\n      name=~\"$container\"\n    }\n  )\n)",          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 8000000000 },
              { "color": "red", "value": 12000000000 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Network Traffic",
      "id": 4,
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "sum(\n  max by (name)(\n    rate(container_network_receive_bytes_total{\n      id=~\"^/system\\\\.slice/docker-.*$\",\n      name=~\"$container\"\n    }[$interval])\n  )\n)\n+\nsum(\n  max by (name)(\n    rate(container_network_transmit_bytes_total{\n      id=~\"^/system\\\\.slice/docker-.*$\",\n      name=~\"$container\"\n    }[$interval])\n  )\n)",          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20000000 },
              { "color": "red", "value": 50000000 }
            ]
          }
        }
      }
    },

    {
      "type": "row",
      "title": "CPU",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "CPU Usage by Container",
      "id": 5,
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "max by (name)(\n  rate(\n    container_cpu_usage_seconds_total{\n      id=~\"^/system\\\\.slice/docker-.*$\",\n      name=~\"$container\"\n    }[$interval]\n  )\n) * 100",          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max", "mean"]
        }
      }
    },
    {
      "type": "gauge",
      "title": "CPU Usage %",
      "id": 6,
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "max by (name)(\n  rate(\n    container_cpu_usage_seconds_total{\n      id=~\"^/system\\\\.slice/docker-.*$\",\n      name=~\"$container\"\n    }[$interval]\n  )\n) * 100",          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "options": {
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "values": false,
          "calcs": ["mean"],
          "fields": ""
        }
      }
    },

    {
      "type": "row",
      "title": "Memory",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Memory Usage by Container",
      "id": 7,
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "max by (name)(\n  container_memory_usage_bytes{\n    id=~\"^/system\\\\.slice/docker-.*$\",\n    name=~\"$container\"\n  }\n)",          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max", "mean"]
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Memory Usage Comparison",
      "id": 8,
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "max by (name)(\n  container_memory_usage_bytes{\n    id=~\"^/system\\\\.slice/docker-.*$\",\n    name=~\"$container\"\n  }\n)",          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000000000 },
              { "color": "red", "value": 2000000000 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      }
    },

    {
      "type": "row",
      "title": "Network & Disk",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Network Traffic by Container",
      "id": 9,
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "max by (name)(\n  rate(\n    container_network_receive_bytes_total{\n      id=~\"^/system\\\\.slice/docker-.*$\",\n      name=~\"$container\"\n    }[$interval]\n  )\n)",          "legendFormat": "{{name}} (in)",
          "refId": "A"
        },
        {
          "expr": "max by (name)(\n  rate(\n    container_network_transmit_bytes_total{\n      id=~\"^/system\\\\.slice/docker-.*$\",\n      name=~\"$container\"\n    }[$interval]\n  )\n)",          "legendFormat": "{{name}} (out)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max", "mean"]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Disk I/O by Container",
      "id": 10,
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "max by (name)(\n  rate(\n    container_fs_reads_bytes_total{\n      id=~\"^/system\\\\.slice/docker-.*$\",\n      name=~\"$container\"\n    }[$interval]\n  )\n)",          "legendFormat": "{{name}} (reads)",
          "refId": "A"
        },
        {
          "expr": "max by (name)(\n  rate(\n    container_fs_writes_bytes_total{\n      id=~\"^/system\\\\.slice/docker-.*$\",\n      name=~\"$container\"\n    }[$interval]\n  )\n)",          "legendFormat": "{{name}} (writes)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max", "mean"]
        }
      }
    },

    {
      "type": "row",
      "title": "Container Status",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "table",
      "title": "Container Status Overview",
      "id": 11,
      "gridPos": { "x": 0, "y": 33, "w": 24, "h": 8 },
      "datasource": "VictoriaMetrics",
      "targets": [
        {
          "expr": "max by (name)(\n  container_last_seen{\n    id=~\"^/system\\\\.slice/docker-.*$\",\n    name=~\"$container\"\n  }\n)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": false,
              "__name__": true,
              "container_label_org_label_schema_version": true,
              "id": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "Last Seen",
              "name": "Container Name",
              "image": "Image"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Last Seen" },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      }
    }
  ]
}