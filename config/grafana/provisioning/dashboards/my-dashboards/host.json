{
  "title": "Host Monitoring Dashboard",
  "uid": "host-metrics",
  "schemaVersion": 36,
  "version": 0,
  "tags": ["performance", "system", "monitoring"],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "10s",
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": {
          "query": "label_values(host_boot_time, instance)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "sort": 0,
        "skipUrlSync": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "title": "Host Overview",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "title": "Uptime",
      "type": "stat",
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "host_uptime",
          "legendFormat": "Uptime"
        }
      ],
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "id": 2
    },
    {
      "title": "CPU Threads",
      "type": "stat",
      "datasource": "VictoriaMetrics",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "host_logical_cpus",
          "legendFormat": "Threads"
        }
      ],
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "title": "Total RAM",
      "type": "stat",
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "host_memory_total_bytes",
          "legendFormat": "Total RAM"
        }
      ],
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "id": 4
    },
    {
      "title": "CPU Load",
      "type": "gauge",
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 70,  "color": "orange" },
              { "value": 90,  "color": "red" }
            ]
          }
        }
      },
      "options": {
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "100 - (avg(rate(host_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU Load"
        }
      ],
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "id": 5
    },
    {
      "title": "Memory Use",
      "type": "gauge",
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 70,  "color": "orange" },
              { "value": 90,  "color": "red" }
            ]
          }
        }
      },
      "options": {
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "(host_memory_used_bytes / host_memory_total_bytes) * 100",
          "legendFormat": "Memory Use %"
        }
      ],
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "id": 6
    },
    {
      "title": "Disk Free (Total)",
      "type": "stat",
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 21474836480, "color": "orange" },
              { "value": 53687091200, "color": "green" }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(\n  max by (device) (\n    host_filesystem_free_bytes{filesystem=~\"ext4|btrfs|xfs\"}\n  )\n)",
          "legendFormat": "Free Space"
        }
      ],
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "id": 7
    },
    {
      "title": "Net IN (24h)",
      "type": "stat",
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
