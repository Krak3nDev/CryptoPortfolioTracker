      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 6 },
      "id": 9
    },
    {
      "title": "CPU Details",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "id": 11
    },
    {
      "title": "CPU Load",
      "type": "timeseries",
      "datasource": "VictoriaMetrics",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" }
            ]
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": { "mode": "off" }
          }
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "avg by (mode) (rate(host_cpu_seconds_total{mode=\"idle\"}[5m]) * 100)",
          "legendFormat": "idle"
        },
        {
          "expr": "avg by (mode) (rate(host_cpu_seconds_total{mode=\"user\"}[5m]) * 100)",
          "legendFormat": "user"
        },
        {
          "expr": "avg by (mode) (rate(host_cpu_seconds_total{mode=\"system\"}[5m]) * 100)",
          "legendFormat": "system"
        },
        {
          "expr": "avg by (mode) (rate(host_cpu_seconds_total{mode=\"iowait\"}[5m]) * 100)",
          "legendFormat": "iowait"
        },
        {
          "expr": "avg by (mode) (rate(host_cpu_seconds_total{mode=\"nice\"}[5m]) * 100)",
          "legendFormat": "nice"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 12
    },
