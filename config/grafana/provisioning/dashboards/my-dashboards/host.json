        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(host_network_receive_bytes_total[24h]))",
          "legendFormat": "Net In"
        }
      ],
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 6 },
      "id": 8
    },
    {
      "title": "Net OUT (24h)",
